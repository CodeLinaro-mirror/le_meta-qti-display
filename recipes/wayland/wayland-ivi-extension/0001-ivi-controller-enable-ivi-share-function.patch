From 0eb2cb96ef5c417f8c1567a77bfe6bdb836add0a Mon Sep 17 00:00:00 2001
From: LiangHui Chen <lianghui@codeaurora.org>
Date: Mon, 29 Jan 2018 16:57:05 +0800
Subject: [PATCH] ivi-controller: enable ivi share function

1. Change the buffer sharing handle frome name to fd.
2. Fix simple-ivi-share app block issue.
3. Support UBWC buffer sharing.

Signed-off-by: LiangHui Chen <lianghui@codeaurora.org>
---
 .../simple-ivi-share/CMakeLists.txt                |   4 +
 .../simple-ivi-share/src/simple-ivi-share.c        | 117 +++++++++++++---
 protocol/ivi-share.xml                             |  10 +-
 weston-ivi-shell/CMakeLists.txt                    |   5 +
 weston-ivi-shell/src/ivi-share-gbm.c               | 154 ++++++++++++++-------
 weston-ivi-shell/src/ivi-share.c                   |  12 +-
 weston-ivi-shell/src/ivi-share.h                   |   7 +-
 7 files changed, 231 insertions(+), 78 deletions(-)

diff --git a/ivi-layermanagement-examples/simple-ivi-share/CMakeLists.txt b/ivi-layermanagement-examples/simple-ivi-share/CMakeLists.txt
index 7401d08..e54a08b 100644
--- a/ivi-layermanagement-examples/simple-ivi-share/CMakeLists.txt
+++ b/ivi-layermanagement-examples/simple-ivi-share/CMakeLists.txt
@@ -34,6 +34,7 @@ pkg_check_modules(GLESv2 glesv2 REQUIRED)
 pkg_check_modules(EGL egl REQUIRED)
 pkg_check_modules(WAYLAND_EGL wayland-egl REQUIRED)
 pkg_check_modules(WAYLAND_CLIENT wayland-client REQUIRED)
+pkg_check_modules(GBM gbm REQUIRED)
 
 GET_TARGET_PROPERTY(IVI_EXTENSION_PROTOCOL_DIRS ivi-extension-protocol INCLUDE_DIRECTORIES)
 
@@ -43,12 +44,14 @@ include_directories(
     ${GLESv2_INCLUDE_DIRS}
     ${EGL_INCLUDE_DIRS}
     ${WAYLAND_CLIENT_INCLUDE_DIR}
+    ${GBM_INCLUDE_DIRS}
 )
 
 link_directories(
     ${GLESv2_LIBRARY_DIRS}
     ${EGL_LIBRARY_DIRS}
     ${WAYLAND_CLIENT_LIBRARY_DIRS}
+    ${GBM_LIBRARY_DIRS}
 )
 
 SET(LIBS
@@ -58,6 +61,7 @@ SET(LIBS
     ${WAYLAND_CLIENT_LIBRARIES}
     ${WAYLAND_EGL_LIBRARIES}
     ${EGL_LIBRARIES}
+    ${GBM_LIBRARIES}
     m
 )
 
diff --git a/ivi-layermanagement-examples/simple-ivi-share/src/simple-ivi-share.c b/ivi-layermanagement-examples/simple-ivi-share/src/simple-ivi-share.c
index 56d98d9..a2ace5c 100644
--- a/ivi-layermanagement-examples/simple-ivi-share/src/simple-ivi-share.c
+++ b/ivi-layermanagement-examples/simple-ivi-share/src/simple-ivi-share.c
@@ -22,19 +22,22 @@
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <fcntl.h>
 #include <assert.h>
 #include <signal.h>
-
 #include <wayland-client.h>
 #include <wayland-egl.h>
-
 #include <EGL/egl.h>
 #include <EGL/eglext.h>
 #include <GLES2/gl2.h>
 #include <GLES2/gl2ext.h>
+#include <drm/drm_fourcc.h>
 
 #include "ivi-application-client-protocol.h"
 #include "ivi-share-client-protocol.h"
+#include "gbm_priv.h"
+
+#define DRM_DEV_NAME "/dev/dri/card0"
 
 struct window;
 
@@ -82,7 +85,8 @@ struct window {
         uint32_t    width;
         uint32_t    height;
         uint32_t    stride;
-        uint32_t    name;
+        uint32_t    format;
+        int32_t     fd;
         uint32_t    input_caps;
         EGLImageKHR eglimage;
     } share_buffer;
@@ -92,6 +96,9 @@ struct window {
 
 static int running = 1;
 
+static int fd = -1;
+static struct gbm_device *gbm = NULL;
+
 /*----------------------------------------------------------------------------*/
 
 static PFNEGLCREATEIMAGEKHRPROC            pfEglCreateImageKHR;
@@ -163,42 +170,91 @@ redraw(struct window *window, struct wl_callback *callback, uint32_t time)
     eglSwapBuffers(display->egl.egldisplay, window->eglsurface);
 }
 
+static uint32_t
+convert_to_drm_format(uint32_t format)
+{
+    uint32_t drm_format = 0;
+
+    switch (format)
+    {
+        case IVI_SHARE_SURFACE_FORMAT_ABGR8888:
+            drm_format = DRM_FORMAT_ABGR8888;
+            break;
+        case IVI_SHARE_SURFACE_FORMAT_ARGB8888:
+            drm_format = DRM_FORMAT_ARGB8888;
+            break;
+        case IVI_SHARE_SURFACE_FORMAT_XRGB8888:
+            drm_format = DRM_FORMAT_XRGB8888;
+            break;
+        default:
+            break;
+    }
+
+    return drm_format;
+}
+
 static void
 handle_share_surface_damage(void *data, struct ivi_share_surface *share_surface,
-                            uint32_t name)
+                            int32_t fd, int32_t meta_fd)
 {
     struct window *window = data;
     struct display *display = window->display;
-    EGLint img_attribs[] = {
-        EGL_WIDTH,                  window->share_buffer.width,
-        EGL_HEIGHT,                 window->share_buffer.height,
-        EGL_DRM_BUFFER_STRIDE_MESA, window->share_buffer.stride,
-        EGL_DRM_BUFFER_FORMAT_MESA, EGL_DRM_BUFFER_FORMAT_ARGB32_MESA,
-        EGL_NONE
+    struct gbm_bo *bo = NULL;
+
+    struct gbm_buf_info  buf_info;
+    EGLint attribs[] = {
+         EGL_WIDTH, 0,
+         EGL_HEIGHT, 0,
+         EGL_LINUX_DRM_FOURCC_EXT, 0,
+         EGL_DMA_BUF_PLANE0_FD_EXT, 0,
+         EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0,
+         EGL_DMA_BUF_PLANE0_PITCH_EXT, 0,
+         EGL_NONE
     };
 
-    if (name == 0) {
+    if (fd < 0) {
+        return;
+    }
+
+    attribs[1]  = window->share_buffer.width;
+    attribs[3]  = window->share_buffer.height;
+    attribs[5]  = convert_to_drm_format(window->share_buffer.format);
+    attribs[7]  = fd;
+    attribs[11] = window->share_buffer.stride;
+
+    buf_info.fd          = fd;
+    buf_info.metadata_fd = meta_fd;
+    buf_info.width       = window->share_buffer.width;
+    buf_info.height      = window->share_buffer.height;
+    buf_info.format      = convert_to_drm_format(window->share_buffer.format);
+
+    bo = gbm_bo_import(gbm, GBM_BO_IMPORT_GBM_BUF_TYPE, &buf_info, GBM_BO_USE_RENDERING);
+    if (bo == NULL) {
+        fprintf(stderr,"create gbm bo failed!");
         return;
     }
 
-    if (window->share_buffer.name != name) {
+    if (window->share_buffer.fd != fd) {
         if (window->share_buffer.eglimage != NULL) {
             pfEglDestroyImageKHR(display->egl.egldisplay,
                                  window->share_buffer.eglimage);
         }
 
         window->share_buffer.eglimage =
-            pfEglCreateImageKHR(display->egl.egldisplay, EGL_NO_CONTEXT,
-                                EGL_DRM_BUFFER_MESA, (EGLClientBuffer)name,
-                                img_attribs);
+            eglCreateImageKHR(display->egl.egldisplay, EGL_NO_CONTEXT,
+                              EGL_LINUX_DMA_BUF_EXT, NULL,
+                              attribs);
+
         if (window->share_buffer.eglimage == NULL) {
             fprintf(stderr, "failed to create EGLImageKHR: 0x%04x\n",
                 eglGetError());
         }
 
         /* update */
-        window->share_buffer.name = name;
+        window->share_buffer.fd = fd;
     }
+
+    gbm_bo_destroy(bo);
 }
 
 static void
@@ -221,10 +277,11 @@ handle_share_surface_configure(void *data, struct ivi_share_surface *share_surfa
         window->geometry.height = height;
     }
 
-    window->share_buffer.name   = 0;
+    window->share_buffer.fd     = -1;
     window->share_buffer.width  = width;
     window->share_buffer.height = height;
     window->share_buffer.stride = stride;
+    window->share_buffer.format = format;
 }
 
 static void
@@ -350,8 +407,9 @@ init_gl(struct window *window)
 
     window->gl.pos     = 0;
     window->gl.tex_pos = 1;
-    glBindAttribLocation(program, window->gl.pos, "pos");
-    glBindAttribLocation(program, window->gl.tex_pos, "tex_pos");
+
+    glBindAttribLocation(program, window->gl.pos, "position");
+    glBindAttribLocation(program, window->gl.tex_pos, "texcoord");
     glLinkProgram(program);
 
     glEnableVertexAttribArray(window->gl.pos);
@@ -415,6 +473,8 @@ create_window(struct window *window)
         return -1;
     }
 
+    eglSwapInterval(display->egl.egldisplay, 0);
+
     if (init_gl(window) < 0) {
         return -1;
     }
@@ -636,6 +696,11 @@ destroy_window(struct window *window)
     if (window->surface)
         wl_surface_destroy(window->surface);
 
+    if (window->share_buffer.eglimage != NULL) {
+        pfEglDestroyImageKHR(window->display->egl.egldisplay,
+                             window->share_buffer.eglimage);
+    }
+
     eglTerminate(window->display->egl.egldisplay);
     eglReleaseThread();
 }
@@ -681,6 +746,18 @@ main(int argc, char **argv)
     window.geometry.width = 250;
     window.geometry.height = 250;
 
+    fd = open(DRM_DEV_NAME, O_RDWR);
+    if (fd < 0) {
+        fprintf(stderr, "Open drm device failed!\n");
+        return 1;
+    }
+    gbm = gbm_create_device(fd);
+    if (gbm == NULL) {
+        fprintf(stderr, "Create gbm device failed!\n");
+        close(fd);
+        return 1;
+    }
+
     if (create_display(&display) < 0) {
         return 1;
     }
@@ -711,6 +788,8 @@ main(int argc, char **argv)
     printf("exit simple-ivi-share\n");
     destroy_window(&window);
     destroy_display(&display);
+    gbm_device_destroy(gbm);
+    close(fd);
 
     return 0;
 }
diff --git a/protocol/ivi-share.xml b/protocol/ivi-share.xml
index 9be7113..729ebc6 100644
--- a/protocol/ivi-share.xml
