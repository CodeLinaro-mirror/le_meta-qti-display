                                      p_nativesurface->format);
 }
 
 static void
-send_damage(struct wl_resource *p_resource, uint32_t id, uint32_t name)
+send_damage(struct wl_resource *p_resource, uint32_t id, int32_t fd, int32_t meta_fd)
 {
     if (!p_resource)
         return;
 
-    ivi_share_surface_send_damage(p_resource, name);
+    ivi_share_surface_send_damage(p_resource, fd, meta_fd);
 }
 
 static void
@@ -611,7 +610,8 @@ send_to_client(struct ivi_share_nativesurface *p_nativesurface, uint32_t send_fl
         }
         if ((IVI_SHAREBUFFER_DAMAGE & send_flag) == IVI_SHAREBUFFER_DAMAGE) {
             send_damage(p_link->resource, p_nativesurface->id,
-                        get_buffer_name(p_nativesurface->surface, shell_ext));
+                        get_buffer_fd(p_nativesurface->surface, shell_ext),
+                        get_meta_buffer_fd(p_nativesurface->surface, shell_ext));
         }
     }
 }
