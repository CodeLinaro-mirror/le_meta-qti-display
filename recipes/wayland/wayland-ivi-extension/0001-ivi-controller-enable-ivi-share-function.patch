      )
 endif (IVI_SHARE)
 
diff --git a/weston-ivi-shell/src/ivi-share-gbm.c b/weston-ivi-shell/src/ivi-share-gbm.c
index 310270b..8e56af8 100644
--- a/weston-ivi-shell/src/ivi-share-gbm.c
+++ b/weston-ivi-shell/src/ivi-share-gbm.c
@@ -24,18 +24,29 @@
 #include <string.h>
 #include <assert.h>
 #include <sys/time.h>
+#include <sys/mman.h>
 #include <xf86drm.h>
 #include <xf86drmMode.h>
 #include <gbm.h>
+#include <gbm_priv.h>
 #include <libudev.h>
 
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <EGL/eglwaylandext.h>
+
 #include "wayland-server.h"
 #include "weston/compositor.h"
 #include "ivi-share-server-protocol.h"
 #include "ivi-controller-interface.h"
 #include "ivi-share.h"
 
-static uint32_t nativesurface_name;
+#define ALIGN(x, align) (((x) + ((align)-1)) & ~((align)-1))
+
+static int32_t nativesurface_fd = -1;
+static int32_t nativesurface_meta_fd = -1;
+
+static PFNEGLQUERYWAYLANDBUFFERWL query_wayland_buffer = NULL;
 
 /* copied from libinput-seat.h of weston-1.9.0 */
 struct udev_input {
@@ -93,77 +104,126 @@ struct drm_backend {
 	int32_t cursor_height;
 };
 
-uint32_t
-get_buffer_name(struct weston_surface *surface,
+
+
+int32_t
+get_buffer_fd(struct weston_surface *surface,
+                struct ivi_shell_share_ext *shell_ext)
+{
+     (void)surface;
+     return nativesurface_fd;
+}
+
+int32_t
+get_meta_buffer_fd(struct weston_surface *surface,
                 struct ivi_shell_share_ext *shell_ext)
 {
      (void)surface;
-     return nativesurface_name;
+     return nativesurface_meta_fd;
+}
+
+static uint32_t
+convert_to_ivi_share_format(uint32_t format)
+{
+    uint32_t ivi_share_format = IVI_SHARE_SURFACE_FORMAT_UNKNOWN;
+
+    switch (format)
+    {
+        case GBM_FORMAT_ABGR8888:
+            ivi_share_format = IVI_SHARE_SURFACE_FORMAT_ABGR8888;
+            break;
+        case GBM_FORMAT_ARGB8888:
+            ivi_share_format = IVI_SHARE_SURFACE_FORMAT_ARGB8888;
+            break;
+        case GBM_FORMAT_XRGB8888:
+            ivi_share_format = IVI_SHARE_SURFACE_FORMAT_XRGB8888;
+            break;
+        default:
+            break;
+    }
+
+    return ivi_share_format;
 }
 
 uint32_t
 update_buffer_nativesurface(struct ivi_share_nativesurface *p_nativesurface,
                             struct ivi_shell_share_ext *shell_ext)
 {
+    struct drm_backend *backend = NULL;
+    struct linux_dmabuf_buffer *dmabuf = NULL;
+    struct weston_buffer *buffer = NULL;
+    struct gbm_buffer *gbm_buffer = NULL;
+    struct gbm_buf_info *buf_info = NULL;
+    struct wl_shm_buffer *shm_buffer = NULL;
+    EGLint format;
+    unsigned int alignment = 32;
+
     if (NULL == p_nativesurface || NULL == p_nativesurface->surface) {
         return IVI_SHAREBUFFER_NOT_AVAILABLE;
     }
 
-    struct drm_backend *backend =
-        (struct drm_backend*)p_nativesurface->surface->compositor->backend;
+    backend = (struct drm_backend*)p_nativesurface->surface->compositor->backend;
     if (NULL == backend) {
         return IVI_SHAREBUFFER_NOT_AVAILABLE;
     }
 
-    struct weston_buffer *buffer = p_nativesurface->surface->buffer_ref.buffer;
+    if (query_wayland_buffer == NULL)
+        query_wayland_buffer = (void *) eglGetProcAddress("eglQueryWaylandBufferWL");
+
+    buffer = p_nativesurface->surface->buffer_ref.buffer;
     if (!buffer) {
         return IVI_SHAREBUFFER_NOT_AVAILABLE;
     }
 
-    struct gbm_bo *bo = gbm_bo_import(backend->gbm, GBM_BO_IMPORT_WL_BUFFER,
-                                      buffer->legacy_buffer, GBM_BO_USE_SCANOUT);
-    if (!bo) {
-        weston_log("failed to import gbm_bo\n");
-        return IVI_SHAREBUFFER_INVALID;
-    }
+    shm_buffer = wl_shm_buffer_get(buffer->resource);
 
-    struct drm_gem_flink flink = {0};
-    flink.handle = gbm_bo_get_handle(bo).u32;
-    if (drmIoctl(gbm_device_get_fd(backend->gbm), DRM_IOCTL_GEM_FLINK, &flink) != 0) {
-        weston_log("gem_flink: returned non-zero failed\n");
-        gbm_bo_destroy(bo);
-        return IVI_SHAREBUFFER_INVALID;
+    if (shm_buffer) {
+        return IVI_SHAREBUFFER_INVALID; //don't support yet.
     }
-
-    uint32_t name   = flink.name;
-    uint32_t width  = gbm_bo_get_width(bo);
-    uint32_t height = gbm_bo_get_height(bo);
-    uint32_t stride = gbm_bo_get_stride(bo);
-    uint32_t format = IVI_SHARE_SURFACE_FORMAT_ARGB8888;
-    uint32_t ret    = IVI_SHAREBUFFER_STABLE;
-
-    nativesurface_name = name;
-
-    if (name != p_nativesurface->name) {
-        ret |= IVI_SHAREBUFFER_DAMAGE;
+    else if ((query_wayland_buffer != NULL) &&
+               query_wayland_buffer(eglGetCurrentDisplay(), (void *) buffer->resource,
+                                    EGL_TEXTURE_FORMAT, &format)) {
+        buf_info = wl_resource_get_user_data(buffer->resource);
+        int32_t  fd          = buf_info->fd;
+        int32_t  metadata_fd = buf_info->metadata_fd;
+        uint32_t width       = buf_info->width;
+        uint32_t height      = buf_info->height;
+        uint32_t stride      = ALIGN(width, alignment) * 4; //in bytes
+        uint32_t format      = convert_to_ivi_share_format(buf_info->format);
+        uint32_t ret         = IVI_SHAREBUFFER_STABLE;
+
+        nativesurface_fd = fd;
+        nativesurface_meta_fd = metadata_fd;
+
+        if (fd != p_nativesurface->fd) {
+            ret |= IVI_SHAREBUFFER_DAMAGE;
+        }
+        if (width != p_nativesurface->width) {
+            ret |= IVI_SHAREBUFFER_CONFIGURE;
+        }
+        if (height != p_nativesurface->height) {
+            ret |= IVI_SHAREBUFFER_CONFIGURE;
+        }
+        if (stride != p_nativesurface->stride) {
+            ret |= IVI_SHAREBUFFER_CONFIGURE;
+        }
+
+        p_nativesurface->fd     = fd;
+        p_nativesurface->width  = width;
+        p_nativesurface->height = height;
+        p_nativesurface->stride = stride;
+        p_nativesurface->format = format;
+
+        return ret;
     }
-    if (width != p_nativesurface->width) {
-        ret |= IVI_SHAREBUFFER_CONFIGURE;
+    else if (dmabuf = linux_dmabuf_buffer_get(buffer->resource)) {
+        return IVI_SHAREBUFFER_INVALID; //don't support yet.
     }
-    if (height != p_nativesurface->height) {
-        ret |= IVI_SHAREBUFFER_CONFIGURE;
+    else if (gbm_buffer = gbm_buffer_get(buffer->resource)) {
+        return IVI_SHAREBUFFER_INVALID; //don't support yet.
     }
-    if (stride != p_nativesurface->stride) {
-        ret |= IVI_SHAREBUFFER_CONFIGURE;
+    else {
+        return IVI_SHAREBUFFER_NOT_AVAILABLE;
     }
-
-    p_nativesurface->name   = name;
-    p_nativesurface->width  = width;
-    p_nativesurface->height = height;
-    p_nativesurface->stride = stride;
-    p_nativesurface->format = format;
-
-    gbm_bo_destroy(bo);
-
-    return ret;
 }
+
diff --git a/weston-ivi-shell/src/ivi-share.c b/weston-ivi-shell/src/ivi-share.c
