-            <entry name="unknown" value="2"/>
+            <entry name="abgr8888" value="0"/>
+            <entry name="argb8888" value="1"/>
+            <entry name="xrgb8888" value="2"/>
+            <entry name="unknown" value="3"/>
         </enum>
 
         <event name="damage">
@@ -69,7 +70,8 @@
               Notify if shared ivi_surface is updated in client.
             </description>
 
-            <arg name="name" type="uint"/>
+            <arg name="fd" type="fd"/>
+            <arg name="meta_fd" type="fd"/>
         </event>
 
         <event name="configure">
diff --git a/weston-ivi-shell/CMakeLists.txt b/weston-ivi-shell/CMakeLists.txt
index d88694e..f4ff63d 100644
--- a/weston-ivi-shell/CMakeLists.txt
+++ b/weston-ivi-shell/CMakeLists.txt
