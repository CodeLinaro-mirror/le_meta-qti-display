From ac0d0d7d097390813919f0aa8913564b47245e06 Mon Sep 17 00:00:00 2001
From: Lei wang <leiwan@codeaurora.org>
Date: Sun, 29 Apr 2018 14:46:37 +0800
Subject: [PATCH] Change-socket-mode-add-rw-for-group

Signed-off-by: Lei wang <leiwan@codeaurora.org>
---
 src/wayland-server.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/src/wayland-server.c b/src/wayland-server.c
index 0f04f66..3d2ca4d 100644
--- a/src/wayland-server.c
+++ b/src/wayland-server.c
@@ -1144,6 +1144,11 @@ _wl_display_add_socket(struct wl_display *display, struct wl_socket *s)
 		return -1;
 	}
 
+	if (chmod(s->addr.sun_path, 0775) < 0) {
+		wl_log("chmod() failed with error: %m\n");
+		return -1;
+	}
+
 	if (listen(s->fd, 128) < 0) {
 		wl_log("listen() failed with error: %m\n");
 		return -1;
-- 
1.9.1

