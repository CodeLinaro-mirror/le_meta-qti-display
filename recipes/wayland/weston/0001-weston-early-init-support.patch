+static int
+gl_loaded(void *data)
+{
+    struct weston_compositor *compositor = data;
+    int (*module_init)(struct weston_compositor *ec, int *argc, char *argv[]);
+    weston_log("Weston fakebo timer end\n");
+    g_early.gl_loaded = 1;
+    if (compositor->early->early_desktop) {
+        place_marker("W ==========loading desktop");
+        module_init = weston_load_module_from_array(2);
+        if (!module_init)
+            return -1;
+        if (module_init(compositor, 0, NULL) < 0)
+            return -1;
+    }
+    return 1;
+}
