+static int
+gl_loaded(void *data)
+{
+	struct weston_compositor *compositor = data;
+	place_marker("W ==========desktop loaded");
+	weston_log("Weston early_desktop timer end\n");
+	int (*module_init)(struct weston_compositor *ec, int *argc, char *argv[]);
+
+	g_early.gl_loaded = 1;
+	module_init = weston_load_module_from_array(2);
+	if (!module_init)
+		return -1;
+	if (module_init(compositor, 0, NULL) < 0)
+		return -1;
+	return 1;
+}
+
