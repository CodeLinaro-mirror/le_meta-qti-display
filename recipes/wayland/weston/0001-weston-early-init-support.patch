+void * bg_init_input(void * arg)
+{
+	struct udev_para * para = (struct udev_para *)arg;
+	int retry = 0;
+
+	weston_log("weston udev_input_init begin\n");
+	while (retry++ < 100) {
+		sleep(1);
+		if (udev_input_init(para->input,
+				para->compositor, para->udev, para->seat_id) == 0) {
+			weston_log("udev_input_init ok\n");
+			weston_launcher_data_monitor(para->compositor);
+			break;
+		}
+		weston_log("udev_input_init fail(%d), continue...\n", retry);
+	}
+	return 0;
