 WL_EXPORT void *
+weston_load_module_from_array(int index)
+{
+    int retry = 0;
+
+    while (retry++ < 100) {
+        if(NULL != g_early.libModules[index]) {
+            break;
+        }
+        usleep(10000);//10ms
+    }
+	char log[100] = {0};
+	sprintf(log, "W ==========load lib[%d] @ %d times", index, retry);
+	place_marker(log);
+	weston_log("%s\n", log);
+    return g_early.libModules[index];
+}
