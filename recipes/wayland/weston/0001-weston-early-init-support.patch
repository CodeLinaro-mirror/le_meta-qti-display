+void
+weston_launcher_data_monitor(struct weston_compositor *compositor) {
+	if (!compositor->launcher||compositor->launcher->fd ==-1){
+		weston_log("warning: weston-launch not found\n");
+		return;
+	}
+	struct wl_event_loop *loop = wl_display_get_event_loop(compositor->wl_display);
+	compositor->launcher->source = wl_event_loop_add_fd(loop,
+				compositor->launcher->fd,
+				WL_EVENT_READABLE,
+				weston_launcher_data,
+				compositor->launcher);
+	if (compositor->launcher->source == NULL) {
+		weston_log("warning: handle weston-launch data monitor failed\n");
+	}
+	return;
+}
