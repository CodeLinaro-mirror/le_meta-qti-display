+void place_marker(char*name){int fd=open("/debug/bootkpi/kpi_values",O_WRONLY);if(fd>0){write(fd,name,strlen(name));close(fd);}}
 
 #ifndef DRM_CAP_TIMESTAMP_MONOTONIC
 #define DRM_CAP_TIMESTAMP_MONOTONIC 0x6
@@ -2448,6 +2449,13 @@ drm_backend_create(struct weston_compositor *compositor,
         weston_log("failed to create input devices\n");
     }
 
+    while (drmSetMaster(b->drm.fd)) {
+        weston_log("failed to get drm master permission, wait for 3ms\n");
+        usleep(3*1000);
+    }
+    weston_log("drm master permission got!\n");
+    place_marker("W - create_outputs");
+
     if (create_outputs(b, param->connector, drm_device) < 0) {
             weston_log("failed to create output for %s\n", path);
