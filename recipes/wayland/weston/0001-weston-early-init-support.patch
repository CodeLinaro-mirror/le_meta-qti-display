 		dlclose(module);
+		if (!strcmp(name,"desktop-shell.so")){
+			sprintf(log, "W ==========load %s cache", name);
+			//place_marker(log);
+			return g_early.libModules[2];
+		}
 		return NULL;
 	}
 
