 	ec->idle_source = wl_event_loop_add_timer(loop, idle_handler, ec);
 	wl_event_source_timer_update(ec->idle_source, ec->idle_time * 1000);
+	if (g_early.early_desktop) {
+		weston_log("Weston early_desktop timer begin\n");
+		g_early.gl_source = wl_event_loop_add_timer(loop, gl_loaded, ec);
+		wl_event_source_timer_update(g_early.gl_source, 2000);
+	}
 
 	ec->input_loop = wl_event_loop_create();
 
@@ -4709,6 +4733,23 @@ weston_version(int *major, int *minor, int *micro)
 }
 
 WL_EXPORT void *
+weston_load_module_from_array(int index)
+{
+    int retry = 0;
+
+    while (retry++ < 100) {
+        if(NULL != g_early.libModules[index]) {
+            break;
+        }
+        usleep(10000);//10ms
+    }
+	char log[100] = {0};
+	sprintf(log, "W ==========load lib[%d] @ %d times", index, retry);
+	place_marker(log);
+    return g_early.libModules[index];
+}
+
+WL_EXPORT void *
