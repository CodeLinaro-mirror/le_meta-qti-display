+static void
+destroy_early_layer(struct early_layer *layer)
+{
+    wl_list_remove(&layer->link);
+    drm_output_release_fb(layer->fb->output, layer->fb);
+    free(layer);
+}
+
+static struct early_layer *
+create_early_layer(struct drm_output *output, struct weston_view *ev)
+{
+    struct early_layer *layer = NULL;
+    struct drm_backend *b =
+                (struct drm_backend *)output->base.compositor->backend;
+    struct weston_buffer *buffer = ev->surface->buffer_ref.buffer;
+    struct gbm_bo *bo;
+    uint32_t format;
+    struct linux_dmabuf_buffer *dmabuf;
+    struct gbm_buffer *gbm_buf;
+
+    /* check whether the buffer resource is created by linux dma buf */
+    if ((dmabuf = linux_dmabuf_buffer_get(buffer->resource))) {
+        struct gbm_import_fd_data gbm_dmabuf = {
+            .fd = dmabuf->dmabuf_fd[0],
+            .width = dmabuf->width,
+            .height = dmabuf->height,
+            .stride = dmabuf->stride[0],
+            .format = dmabuf->format
+        };
+        bo = gbm_bo_import(b->gbm, GBM_BO_IMPORT_FD,
+                    &gbm_dmabuf, GBM_BO_USE_SCANOUT);
+    } else if ((gbm_buf = gbm_buffer_get(buffer->resource))) {
+        struct gbm_buf_info gbm_bufinfo = {
+            .fd = gbm_buf->fd,
+            .metadata_fd = gbm_buf->metadata_fd,
+            .width = gbm_buf->width,
+            .height = gbm_buf->height,
+            .format = gbm_buf->format
+        };
+        bo = gbm_bo_import(b->gbm, GBM_BO_IMPORT_GBM_BUF_TYPE,
+                    &gbm_bufinfo, GBM_BO_USE_SCANOUT);
+    } else {
+        bo = gbm_bo_import(b->gbm, GBM_BO_IMPORT_GBM_BUF_TYPE,
+                    wl_resource_get_user_data(buffer->resource),
+                    GBM_BO_USE_SCANOUT);
+    }
+
+    if (bo == NULL) {
+        weston_log("fail to import gbm bo!\n");
+        goto err_base;
+    }
+
+    format = gbm_bo_get_format(bo);
+    if (!format) {
+        weston_log("unsupported format\n");
+        goto err_gbm_bo;
+    }
+
+    layer = zalloc(sizeof(*layer));
+    if (layer == NULL) {
+        weston_log("no enough memory for create early layer\n");
+        goto err_gbm_bo;
+    }
+
+    layer->view = ev;
+    layer->fb = drm_fb_get_from_bo(bo, b, format);
+    if (!layer->fb) {
+        weston_log("get drm fb for early layer failed\n");
+        goto err_layer;
+    }
+
+    drm_fb_set_buffer(layer->fb, buffer);
+    weston_log("weston buffer = 0x%x, drm fb_id = %d\n", buffer, layer->fb->fb_id);
+    return layer;
+
+err_layer:
+    free(layer);
+    layer = NULL;
+err_gbm_bo:
+    gbm_bo_destroy(bo);
+err_base:
+    return NULL;
+}
