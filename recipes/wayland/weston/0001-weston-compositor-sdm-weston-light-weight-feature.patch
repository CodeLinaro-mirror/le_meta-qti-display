+static int
+create_outputs_early(struct drm_backend *b, uint32_t option_connector)
+{
+    uint32_t conn_count = 0;
+    int x=0, y=0;
+    int idx, rc;
+
+
+    get_connector_count(&conn_count);
+    if (!conn_count) {
+        weston_log("fail to get connector num \n");
+        return -1;
+    }
+
+    weston_log("create_outputs_early: conn_count=%d\n", conn_count);
+
+    for (idx = 0; idx < conn_count; idx++) {
+        struct DisplayInfo display_config;
+        bool enable_hw_pipe = false;
+
+        if (idx == 0)
+            enable_hw_pipe = true;
+        rc = create_display(idx, &display_config, enable_hw_pipe);
+        weston_log("CreateDisplay: %d return %d, hw enabled:%d\n",
+                idx, rc, enable_hw_pipe);
+
+        if (create_output_early(b, idx, x, y, &display_config) < 0) {
+            weston_log("Create weston output for display %d failed\n", idx);
+            continue;
+        }
+        x += display_config.x_pixels;
+    }
+
+    unregister_display();
+
+    if (!x)
+        return -1;
+
+    return 0;
+}
