[Unit]
Description= VM File Transfer Service
SourcePath=/usr/bin/VMFileTransferService
StartLimitIntervalSec=0

[Service]
User=system
Groups=system
Restart=no
ExecStartPre=/usr/bin/persistcheck.sh
ExecStart=/usr/bin/VMFileTransferService

[Install]
WantedBy=multi-user.target
