# udev rule for MDSS MDP platform device
# Sets group ownership and permissions on the power/control sysfs node
SUBSYSTEM=="platform", TAG+="systemd", KERNEL=="ae00000.qcom,mdss_mdp", \
        RUN+="/etc/udev/scripts/display_udev_script.sh mdss_power"
